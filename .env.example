# Copy to .env (never commit it).

# Shared secret: the Nakatha API sends it as "Authorization: Bearer <token>". Required unless EPHEMERIS_ALLOW_ANON=1.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EPHEMERIS_TOKEN=

# Local development only: accept requests without a token.
# EPHEMERIS_ALLOW_ANON=1

# Port and bind address. On Render use a *private service*; it must listen on 0.0.0.0 (the default when NODE_ENV=production).
PORT=4010
# HOST=127.0.0.1

# Where GET /source sends people (AGPL section 13: offer the source of the running version). Your public repository URL.
SOURCE_URL=
